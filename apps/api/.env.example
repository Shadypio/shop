# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shop_dev?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Sessioni admin
SESSION_SECRET="change-me-in-production"

# CORS: origine consentita del frontend
WEB_ORIGIN="http://localhost:5173"

# URL pubblico del backend (usato per comporre gli URL delle immagini caricate)
API_PUBLIC_URL="http://localhost:4000"

# Slug dello shop attivo (single-tenant nell'MVP)
SHOP_SLUG="shop-detersivi"

# Storage immagini (Cloudinary, esempio)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
