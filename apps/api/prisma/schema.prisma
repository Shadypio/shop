generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenant (oggi un solo record, ma già modellato per il futuro multi-shop) ---
model Shop {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  admins     AdminUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  createdAt    DateTime @default(now())
}

model Category {
  id     String @id @default(cuid())
  name   String
  slug   String
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  products Product[]

  @@unique([shopId, slug])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  available   Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]

  @@unique([shopId, slug])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  // onDelete Cascade: le immagini sono un dettaglio del prodotto, non hanno
  // senso senza di esso. Diverso da OrderItem, che mantiene volutamente uno
  // snapshot storico e blocca la cancellazione (vedi commento su OrderItem).
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  MODIFIED
  REJECTED
  COMPLETED
}

model Order {
  id               String         @id @default(cuid())
  shopId           String
  shop             Shop           @relation(fields: [shopId], references: [id])
  customerName     String
  customerSurname  String
  phone            String
  address          String?
  notes            String?
  deliveryMethod   DeliveryMethod
  status           OrderStatus    @default(PENDING)
  items            OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot al momento dell'ordine
  unitPrice   Decimal @db.Decimal(10, 2) // snapshot al momento dell'ordine
  quantity    Int
}
